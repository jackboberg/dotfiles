{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/instructions/*.md"],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "permission": {
    "external_directory": {
      "~/.crit/**": "allow",
      "~/.local/share/opencode/plans/**": "allow",
      "/tmp/**": "allow",
    },
  },
}
